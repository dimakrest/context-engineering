# Enforcement: a reviewer is blind by having nothing to look at -- the handoffs and the other
# runs move out of reach for the process lifetime. Leaving them in place is a review of the
# worker's own account of itself.
category=enforcement
file=driver/missions/prep.py
breaks=reviewer-cannot-see-handoffs
# control: a VALIDATE round that runs reviews but does not itself assert blindness -- so it
# proves the mutation broke nothing else. validate-happy-path is NOT a control here: it
# asserts handoffs-visible=absent, which makes it a second `breaks`.
control=conflicting-reviews-not-proven
