# Two reviews of one assertion disagree: F001's reviewer says A002 not satisfied, F002's (later)
# says satisfied, and negotiate proposes nothing. A negative verdict blocks whatever another
# review of the round said -- A001 is proven, A002 stays claimed, nothing is re-opened (it was
# never proven), and the round halts on it naming the negative verdict. (D3 review, decision B1)
rc=5
journal~="event":"verdict".*"feature":"F001".*"A002":"not satisfied".*"file":"validation/M1-review-F001.md"
journal~="event":"verdict".*"feature":"F002".*"A002":"satisfied".*"file":"validation/M1-review-F002.md"
journal~="event":"judgment".*"step":"negotiate".*"task":"negotiate-M1#1".*no findings
journal~="event":"decision".*"step":"proven".*"milestone":"M1".*"round":1.*"assertions":\["A001"\].*"evidence":\{"A001":"validation/M1-review-F001.md"\}
journal~="event":"validate_done".*"milestone":"M1".*"round":1.*"result":"halted"
journal~="event":"halt".*"class":"block".*gate-blocked: M1: A002 not satisfied and no repair proposed
journal~="event":"stop".*"reason":"gate-blocked".*M1: A002 not satisfied and no repair proposed.*sharpen the assertion.*"exit":5
journal!~="event":"decision".*"step":"reopened"
journal!~="event":"milestone_closed"
journal!~="step":"proven".*"assertions":\["A001","A002"\]
journal!~="event":"followups_added"
state~=^phase: halted
state~=^milestone: M1
postcheck=grep -qE '^\| A001 \| .* \| structural \| F001 \| proven \| validation/M1-review-F001.md \|' "$M/contract.md"
postcheck=grep -qE '^\| A002 \| .* \| structural \| F001, F002 \| claimed \| — \|' "$M/contract.md"
postcheck=grep -q '^  A002 \[structural\] — reviewer F001: not satisfied (validation/M1-review-F001.md); reviewer F002: satisfied (validation/M1-review-F002.md) — contract: claimed$' "$M/runs/negotiate-M1#1/prompt.md"
postcheck=bash "$plugin/scripts/check.sh" "$M" >/dev/null
