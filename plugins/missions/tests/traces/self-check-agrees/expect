# The worker runs `missions grade --self` before exiting: it reports the same problems the driver
# finds after exit (rc 2 on the malformed attempt, rc 0 on the good one), and the prompt told it to.
rc=5
journal~="event":"step_done".*"step":"F001#1".*"cls":"malformed_handoff".*missing sections
journal~="event":"step_done".*"step":"F001#2".*"cls":"done"
postcheck=[ "$(cat "$M/runs/F001#1/selfcheck.rc")" = 2 ] && grep -q 'missing sections' "$M/runs/F001#1/selfcheck.txt"
postcheck=[ "$(cat "$M/runs/F001#2/selfcheck.rc")" = 0 ] && grep -q 'handoff valid' "$M/runs/F001#2/selfcheck.txt"
postcheck=grep -q 'missions grade .*demo F001 --self' "$M/runs/F001#1/prompt.md"
