rc=3
args=--limit 1
journal~="event":"agent_return".*"dispatch_id":"F001#1".*"status":"timed_out"
journal~="event":"step_done".*"cls":"stalled"
journal~="event":"stop".*"reason":"limit-reached"
postcheck=[ "$(jq -r 'select(.event=="agent_return") | .duration_s' "$M/journal.jsonl" | head -1)" -lt 15 ]
postcheck=grep -q '"killed_by": "timeout"' "$M/runs/F001#1/outcome.json"
postcheck=sed -n '/^### F001/,/^##/p' "$M/features.md" | grep -q 'Status:\*\* pending'
