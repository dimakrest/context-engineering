# A commit whose subject lacks the feature prefix slipped past commit-msg with --no-verify; the
# grade reads the whole range since launch and rejects the handoff (malformed_handoff), the worker
# is re-dispatched with that rejection, and attempt 2 lands. (D3 review, finding 1)
rc=3
args=--until validate
journal~="event":"dispatch".*"dispatch_id":"F001#1"
journal~="event":"step_done".*"step":"F001#1".*"cls":"malformed_handoff".*do not start with F001:
journal~="event":"dispatch".*"dispatch_id":"F001#2"
journal~="event":"step_done".*"step":"F001#2".*"cls":"done"
journal~="event":"handoff_ingested".*"feature":"F001"
journal~="event":"handoff_ingested".*"feature":"F002"
journal~="event":"stop".*"reason":"limit-reached"
journal!~="event":"halt"
git~=wip
git~=F001: stub work
postcheck=grep -q 'was rejected' "$M/runs/F001#2/prompt.md" && grep -q 'do not start with F001:' "$M/runs/F001#2/prompt.md"
postcheck=! grep -q 'was rejected' "$M/runs/F001#1/prompt.md"
