file=runs/negotiate-M2#1/output.md
postcheck=[ "$(grep -c '"event":"dispatch"' "$M/journal.jsonl")" = 11 ]
postcheck=[ "$(grep -c '"event":"milestone_closed"' "$M/journal.jsonl")" = 2 ]
postcheck=head -1 "$M/validation/M1-scrutiny.md" | grep -E '^<!-- scrutiny-M1#1 · mission-validator-scrutiny · stub · [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z -->$' && [ -z "$(sed -n 2p "$M/validation/M1-scrutiny.md")" ] && sed -n 3p "$M/validation/M1-scrutiny.md" | grep -q '^## Commands'
postcheck=grep -qE '^\| A001 \| .* \| structural \| F001 \| proven \| validation/M1-review-F001.md \|' "$M/contract.md"
postcheck=grep -qE '^\| A002 \| .* \| structural \| F001, F002 \| proven \| validation/M1-review-F002.md \|' "$M/contract.md"
postcheck=grep -qE '^\| A003 \| .* \| interface \| F003 \| proven \| validation/M2-behavior.md \|' "$M/contract.md"
postcheck=grep -q 'Patch: .*/patches/F001.patch (base [0-9a-f]\{7\}, head [0-9a-f]\{7\})' "$M/runs/review-F001#1/prompt.md" && ! grep -qE 'handoffs/|## Handoff|git (log|show|diff)' "$M/runs/review-F001#1/prompt.md"
postcheck=grep -q '^  A001 — Omitting the window equals the whole day  proof budget: min: named test; max: 1 pinning feature$' "$M/runs/review-F001#1/prompt.md" && ! grep -q 'A003' "$M/runs/review-F001#1/prompt.md"
postcheck=grep -q '^  A003 — The filter chip is visible on the dashboard  \[interface\]$' "$M/runs/behavior-M2#1/prompt.md" && grep -q '3 live runs' "$M/runs/behavior-M2#1/prompt.md" && ! grep -q 'Filters.tsx' "$M/runs/behavior-M2#1/prompt.md"
postcheck=grep -q '^--- M1-scrutiny.md ---$' "$M/runs/negotiate-M1#1/prompt.md" && grep -q '^--- M1-review-F002.md ---$' "$M/runs/negotiate-M1#1/prompt.md" && grep -q '^## VALIDATE' "$M/runs/negotiate-M1#1/prompt.md" && tail -1 "$M/runs/negotiate-M1#1/prompt.md" | grep -q '^Answer with the JSON object only.$'
postcheck=grep -q '^  A001 \[structural\] — reviewer F001: satisfied (validation/M1-review-F001.md) — contract: claimed$' "$M/runs/negotiate-M1#1/prompt.md"
postcheck=grep -q '^  A002 \[structural\] — reviewer F001: satisfied (validation/M1-review-F001.md); reviewer F002: satisfied (validation/M1-review-F002.md) — contract: claimed$' "$M/runs/negotiate-M1#1/prompt.md"
postcheck=grep -q '^  A003 \[interface\] — reviewer F003: satisfied (validation/M2-review-F003.md); behavior: proven (validation/M2-behavior.md) — contract: claimed$' "$M/runs/negotiate-M2#1/prompt.md"
postcheck=grep -q '^--- M2-behavior.md ---$' "$M/runs/negotiate-M2#1/prompt.md" && ! grep -q 'M1-scrutiny.md ---' "$M/runs/negotiate-M2#1/prompt.md"
postcheck=[ "$(cat "$M/runs/review-F001#1/handoffs-visible.txt")" = absent ] && [ "$(cat "$M/runs/review-F003#1/handoffs-visible.txt")" = absent ]
postcheck=grep -q 'MISSIONS_ROLE' "$M/runs/scrutiny-M1#1/env-names.txt" && ! grep -q 'MISSIONS_FILES' "$M/runs/review-F001#1/env-names.txt"
postcheck=bash "$plugin/scripts/check.sh" "$M" >/dev/null && bash "$plugin/scripts/mission-state.sh" "$M" >/dev/null && bash "$plugin/scripts/mission-converge.sh" "$M" M2 >/dev/null
