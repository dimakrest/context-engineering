# The VALIDATE sequence end to end under the base stubs: M1's two features done -> scrutiny ->
# a blind review per feature, serial under the lease -> no behavior run (M1 has no interface
# assertion) -> negotiate (static, nothing to register) -> A001, A002 proven from the reviews ->
# converge, archive, M2 -> F003 -> scrutiny -> review -> behavior (A003 is interface) -> A003
# proven from the behavior run, not the review -> done, phase left at validating for the terminal
# steps. (#13, design §6.2, §6.1 "proven is written only from a validator verdict")
rc=0
journal~="event":"handoff_ingested".*"feature":"F002"
journal~="event":"decision".*implementing -> validating.*M1 complete
journal~="event":"validate_start".*"milestone":"M1".*"round":1
journal~="event":"dispatch".*"agent":"mission-validator-scrutiny".*"class":"executor".*"milestone":"M1".*"dispatch_id":"scrutiny-M1#1".*"step":"scrutiny"
journal~="event":"lease_released".*dispatch_id=scrutiny-M1#1
journal~="event":"step_done".*"step":"scrutiny-M1#1".*"role":"scrutiny".*"cls":"ok"
journal~="event":"verdict".*"validator":"mission-validator-scrutiny".*"milestone":"M1".*"file":"validation/M1-scrutiny.md".*"commands":1.*"failed":\[\]
journal~="event":"validate_step".*"milestone":"M1".*"round":1.*"step":"scrutiny".*"task":"scrutiny-M1#1".*"file":"validation/M1-scrutiny.md"
journal~="event":"dispatch".*"agent":"mission-reviewer".*"class":"executor".*"feature":"F001".*"milestone":"M1".*"dispatch_id":"review-F001#1".*"step":"reviewer"
journal~="event":"lease_released".*agent=mission-reviewer feature=F001 dispatch_id=review-F001#1
journal~="event":"verdict".*"validator":"mission-reviewer".*"feature":"F001".*"milestone":"M1".*"round":1.*"assertions":\{"A001":"satisfied","A002":"satisfied"\}.*"file":"validation/M1-review-F001.md"
journal~="event":"validate_step".*"step":"reviewer".*"feature":"F001".*"task":"review-F001#1".*"file":"validation/M1-review-F001.md"
journal~="event":"dispatch".*"agent":"mission-reviewer".*"feature":"F002".*"dispatch_id":"review-F002#1"
journal~="event":"verdict".*"feature":"F002".*"assertions":\{"A002":"satisfied"\}.*"file":"validation/M1-review-F002.md"
journal~="event":"dispatch".*"agent":"mission-judgment".*"class":"static".*"milestone":"M1".*"dispatch_id":"negotiate-M1#1".*"step":"negotiate"
journal~="event":"step_done".*"step":"negotiate-M1#1".*"role":"judgment".*"cls":"ok"
journal~="event":"judgment".*"step":"negotiate".*"task":"negotiate-M1#1".*"milestone":"M1".*no findings
journal~="event":"decision".*"step":"proven".*"milestone":"M1".*"assertions":\["A001","A002"\].*"evidence":\{"A001":"validation/M1-review-F001.md","A002":"validation/M1-review-F002.md"\}
journal~="event":"milestone_closed".*"milestone":"M1".*"next":"M2".*"converge":"features 3 · follow-ups 0
journal~="event":"validate_done".*"milestone":"M1".*"round":1.*"result":"closed"
journal~="event":"dispatch".*"dispatch_id":"F003#1"
journal~="event":"handoff_ingested".*"feature":"F003"
journal~="event":"validate_start".*"milestone":"M2".*"round":1
journal~="event":"dispatch".*"dispatch_id":"scrutiny-M2#1"
journal~="event":"dispatch".*"dispatch_id":"review-F003#1"
journal~="event":"verdict".*"feature":"F003".*"assertions":\{"A003":"satisfied"\}
journal~="event":"dispatch".*"agent":"mission-validator-behavior".*"class":"executor".*"milestone":"M2".*"dispatch_id":"behavior-M2#1".*"step":"behavior"
journal~="event":"verdict".*"validator":"mission-validator-behavior".*"milestone":"M2".*"assertions":\{"A003":"proven"\}.*"file":"validation/M2-behavior.md"
journal~="event":"validate_step".*"step":"behavior".*"file":"validation/M2-behavior.md"
journal~="event":"dispatch".*"dispatch_id":"negotiate-M2#1"
journal~="event":"decision".*"step":"proven".*"milestone":"M2".*"assertions":\["A003"\].*"evidence":\{"A003":"validation/M2-behavior.md"\}
journal~="event":"milestone_closed".*"milestone":"M2"
journal~="event":"validate_done".*"milestone":"M2".*"result":"closed"
journal~="event":"stop".*"reason":"done".*all 2 milestone\(s\) validated; every assertion proven.*terminal steps 1-6.*"exit":0
journal!~="dispatch".*"task":"behavior-M1
journal!~="event":"halt"
journal!~="event":"lease_wait"
journal!~="event":"followups_added"
journal!~="event":"features_added"
journal!~="event":"note".*reply rejected
journal!~="event":"agent_stopped"
state~=^phase: validating
state~=^milestone: M2
state~=^resume_next: terminal steps 1-6 of /missions:mission-run: all 2 milestone\(s\) validated
nofile=.lease
nofile=.writer
nofile=.blind
file=validation/M1-scrutiny.md
file=validation/M1-review-F001.md
file=validation/M1-review-F002.md
file=validation/M2-scrutiny.md
file=validation/M2-review-F003.md
file=validation/M2-behavior.md
